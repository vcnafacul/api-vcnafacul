# Seed demo (tickets/053) — SÓ bancos locais. Copiar para .env.seed-demo.
# Tem de cobrir TODAS as chaves do envSchema da api (src/shared/modules/env/env.ts)
# e do form (../vcnafacul-form/src/common/modules/env/env.ts): chave ausente aqui
# é lida do .env real, que aponta para banco remoto. `yarn seed-demo:verificar-env` confere.
# Nenhum valor abaixo é segredo real.
SEED_DEMO=1
SEED_DEMO_SENHA=troque-esta-senha

# ---------- api ----------
API_PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=seed-demo-app-key

# DB (container vcnafacul-demo-mysql)
MY_HOST=localhost
MY_PORT=3308
MY_USER=root
MY_PASSWORD=demo123456
MY_DB_NAME=vcnafacul_demo

# Docs
SWAGGER_AUTH_LOGIN=demo
SWAGGER_AUTH_PASSWORD=demo

# Stack URLs
FRONT_URL=http://localhost:5173
SIMULADO_URL=http://localhost:3999
FORMULARIO_URL=http://localhost:3334
DISCORD_WEBHOOK_URL=http://localhost:9/discord-desligado

# FTP (desligado)
FTP_HOST=127.0.0.1
FTP_USER=demo
FTP_PASSWORD=demo
FTP_PROFILE=demo

# Mail: tudo cai no mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=demo@seed-demo.local
SMTP_PASSWORD=demo
MAIL_USERNAME=demo@seed-demo.local
MAIL_PASSWORD=demo
TEMPLATE_EMAIL=vcnafacul
TEMPLATE_EMAIL_ASSET=vcnafacul
USE_SMTP_FAKE=true
SMTP_FAKE_HOST=localhost
SMTP_FAKE_PORT=1025

# S3 (falso, nada é enviado)
BLOB_PROVIDER=S3
AWS_ACCESS_KEY_ID=seed-demo
AWS_SECRET_ACCESS_KEY=seed-demo
AWS_ENDPOINT=http://localhost:9
AWS_REGION=auto
BUCKET_DOC=demo-docs
BUCKET_STUDENT_DOC=demo-docs
BUCKET_PROFILE=demo-students-photo
BUCKET_QUESTION=demo-questoes
BUCKET_SIMULADO=demo-simulado
BUCKET_CONTENT=demo-content
BUCKET_NEWS=demo-news
BUCKET_HOME=demo-home
BUCKET_PARTNERSHIP_DOC=demo-partnership-doc
BUCKET_ESSAY=demo-essays
BUCKET_CARTAO=demo-cartoes
AWS_STORAGE_CLASS=STANDARD

# Grafana (desligado)
GRAFANA_HOST=http://localhost:9
GRAFANA_USER_ID=1
GRAFANA_TOKEN=seed-demo

# Cache / fila em memória
CACHE_DRIVER=InMemory
REDIS_PORT=6379
REDIS_HOST=localhost
QUEUE_DRIVER=memory

# Segredos falsos
ADMIN_FORM_SECRET=seed-demo-secret
NOTIFICACAO_SECRET=seed-demo-notificacao

# Google (desligado)
GOOGLE_MAPS_API_KEY=seed-demo-disabled
GOOGLE_CLIENT_ID=dev-disabled
GOOGLE_CLIENT_SECRET=dev-disabled
GOOGLE_CALLBACK_URL=http://localhost:3333/user/auth/google/callback

# IA de redação (desligada: sem chave)
ESSAY_AI_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ESSAY_AI_MODEL=gpt-4o

# Firebase / push (desligado)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
PUSH_ENABLED=false
PUSH_DEFAULT_ICON_URL=
PUSH_RECALCULO_ESPERA_MS=1800000

# ---------- form ----------
# Mesmo arquivo; o form lê PORT/MONGODB/NODE_ENV/ADMIN_FORM_SECRET.
# ADMIN_FORM_SECRET é o mesmo da api (divergência = 401 em /admin-form/*).
PORT=3334
MONGODB=mongodb://localhost:27018/form_demo?directConnection=true
