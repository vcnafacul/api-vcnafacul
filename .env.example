# Referência: src/shared/modules/env/env.ts (zod). Valores para rodar no host
# (`yarn dev`). No compose do vcnafacul-stack (tickets/055), os endereços
# (MySQL, Redis, MinIO, ms-simulado, form, Mailpit) são sobrescritos pelo
# próprio compose — não precisa editar nada aqui.
API_PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=troque-me

# Banco: MySQL 8 local (homol e prod são MariaDB — ver CLAUDE.md)
MY_HOST=localhost
MY_PORT=3306
MY_USER=root
MY_PASSWORD=123456
MY_DB_NAME=vcnafacul

# Swagger em /api
SWAGGER_AUTH_LOGIN=vcnafacul
SWAGGER_AUTH_PASSWORD=troque-me

# Endereços do stack
FRONT_URL=http://localhost:5173
SIMULADO_URL=http://localhost:3000
FORMULARIO_URL=http://localhost:3334
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/troque-me

# FTP (Hostinger) — fotos antigas de colaborador
FTP_HOST=0.0.0.0
FTP_USER=
FTP_PASSWORD=
FTP_PROFILE=

# E-mail
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=do.not.reply@vcnafacul.com.br
SMTP_PASSWORD=
MAIL_USERNAME=do.not.reply@vcnafacul.com.br
MAIL_PASSWORD=
TEMPLATE_EMAIL=src/shared/services/email/templates
TEMPLATE_EMAIL_ASSET=src/shared/services/assets/
# Fora de produção, true manda todo e-mail para o Mailpit (UI em http://localhost:8025)
USE_SMTP_FAKE=true
SMTP_FAKE_HOST=localhost
SMTP_FAKE_PORT=1025

# Storage S3/R2 (MinIO local)
BLOB_PROVIDER=S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_STORAGE_CLASS=STANDARD
BUCKET_DOC=vcnafacul-docs
BUCKET_STUDENT_DOC=vcnafacul-docs
BUCKET_PROFILE=vcnafacul-students-photo
BUCKET_QUESTION=simulado-questoes
BUCKET_SIMULADO=vcnafacul-simulado
BUCKET_CONTENT=vcnafacul-content
BUCKET_NEWS=vcnafacul-news
BUCKET_HOME=vcnafacul-home
BUCKET_PARTNERSHIP_DOC=vcnafacul-partnership-doc
BUCKET_ESSAY=vcnafacul-essays
BUCKET_CARTAO=vcnafacul-cartoes

# Logs (Grafana Loki)
GRAFANA_HOST=https://logs-test-024.grafana.net
GRAFANA_USER_ID=1
GRAFANA_TOKEN=

# Cache: inMemory | redis
CACHE_DRIVER=inMemory
REDIS_HOST=localhost
REDIS_PORT=6379

# Fila: 'memory' (in-memory, dev/homol) | 'redis' (prod)
QUEUE_DRIVER=memory

# vcnafacul-form — tem de ser IGUAL ao do form (diferente = 401 em /admin-form/*)
ADMIN_FORM_SECRET=troque-me

# Aviso do ms-simulado (resultado do cartão, tickets/028). Vazio = a rota recusa
# tudo. Tem de ser IGUAL ao do ms-simulado.
NOTIFICACAO_SECRET=troque-me

# Google Places (localiza cursinho) — uma chave por ambiente
GOOGLE_MAPS_API_KEY=

# Login com Google (OAuth) — Google Cloud Console > APIs & Services > Credentials
# > OAuth client ID (Web application). O callback tem de estar em "Authorized redirect URIs".
# Depois de entrar, o callback redireciona para o FRONT_URL. Sem credenciais a api sobe,
# mas o botão do Google dá erro.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# em prod: https://api.vcnafacul.com.br/user/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3333/user/auth/google/callback

# Correção de redação por IA: claude | openai
ESSAY_AI_PROVIDER=openai
ESSAY_AI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Firebase (chat de suporte e push)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Push (pwa-push). Sem as env do Firebase continua desligado; false = interruptor de emergência.
PUSH_ENABLED=true
PUSH_DEFAULT_ICON_URL=
# Espera depois do último recálculo antes do push "nota atualizada" (tickets/042). 30 min.
PUSH_RECALCULO_ESPERA_MS=1800000
